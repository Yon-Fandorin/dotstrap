# ~/.zshrc — Generated by dotstrap/bootstrap.sh
# Manual edits will be overwritten. Use ~/.zshrc.local for personal tweaks.

# ─── History ──────────────────────────────────────────────────────────────────

HISTFILE="${HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS   # remove older duplicates
setopt HIST_FIND_NO_DUPS      # don't show dups when searching
setopt HIST_REDUCE_BLANKS     # trim whitespace
setopt SHARE_HISTORY          # share between sessions
setopt APPEND_HISTORY         # append, don't overwrite
setopt INC_APPEND_HISTORY     # write immediately, not on exit
setopt EXTENDED_HISTORY       # record timestamp

# ─── PATH ─────────────────────────────────────────────────────────────────────

# Local bin
export PATH="${HOME}/.local/bin:${PATH}"

# Cargo (Rust)
[[ -f "${HOME}/.cargo/env" ]] && source "${HOME}/.cargo/env"

# Volta (Node)
export VOLTA_HOME="${HOME}/.volta"
[[ -d "${VOLTA_HOME}/bin" ]] && export PATH="${VOLTA_HOME}/bin:${PATH}"

# Bun
export BUN_INSTALL="${HOME}/.bun"
[[ -d "${BUN_INSTALL}/bin" ]] && export PATH="${BUN_INSTALL}/bin:${PATH}"

# pnpm
export PNPM_HOME="${HOME}/.local/share/pnpm"
[[ -d "$PNPM_HOME" ]] && export PATH="${PNPM_HOME}:${PATH}"

# ─── Completions ──────────────────────────────────────────────────────────────

# Add zsh-completions to fpath (before compinit)
[[ -d "${HOME}/.zsh/zsh-completions/src" ]] && fpath=("${HOME}/.zsh/zsh-completions/src" $fpath)

# Filter out broken completion paths (e.g. Docker Desktop WSL symlinks)
fpath=(${fpath:#*(/mnt/wsl/*)})
for p in $fpath; do [[ -d "$p" ]] || fpath=(${fpath:#$p}); done

# compinit — regenerate dump once per day
autoload -Uz compinit
if [[ -f "${HOME}/.zcompdump" ]]; then
    local zcomp_age=$(( $(date +%s) - $(stat -c %Y "${HOME}/.zcompdump" 2>/dev/null || stat -f %m "${HOME}/.zcompdump" 2>/dev/null || echo 0) ))
    if (( zcomp_age > 86400 )); then
        compinit
    else
        compinit -C
    fi
else
    compinit
fi

# ─── Plugins ──────────────────────────────────────────────────────────────────
# fzf-tab must be loaded before other completion plugins

[[ -f "${HOME}/.zsh/fzf-tab/fzf-tab.plugin.zsh" ]] && source "${HOME}/.zsh/fzf-tab/fzf-tab.plugin.zsh"
[[ -f "${HOME}/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && source "${HOME}/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -f "${HOME}/.zsh/zsh-you-should-use/you-should-use.plugin.zsh" ]] && source "${HOME}/.zsh/zsh-you-should-use/you-should-use.plugin.zsh"
[[ -f "${HOME}/.zsh/zsh-history-substring-search/zsh-history-substring-search.zsh" ]] && source "${HOME}/.zsh/zsh-history-substring-search/zsh-history-substring-search.zsh"
# syntax-highlighting must be loaded last
[[ -f "${HOME}/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && source "${HOME}/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# ─── Key Bindings ─────────────────────────────────────────────────────────────

# history-substring-search: Up/Down arrow keys
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
# Also bind for vi mode / tmux
bindkey '^[OA' history-substring-search-up
bindkey '^[OB' history-substring-search-down

# ─── Editor ───────────────────────────────────────────────────────────────────

if command -v nvim &>/dev/null; then
    export EDITOR='nvim'
    export VISUAL='nvim'
fi

# ─── Tool Init ────────────────────────────────────────────────────────────────

# Starship prompt
eval "$(starship init zsh)"

# fzf key bindings and completion
[[ -f "${HOME}/.fzf.zsh" ]] && source "${HOME}/.fzf.zsh"
if command -v fzf &>/dev/null; then
    eval "$(fzf --zsh 2>/dev/null)" || true
fi

# zoxide (smarter cd)
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

# tmux
if command -v tmux &>/dev/null; then
    alias tm='tmux'
    alias tma='tmux attach -t'
    alias tml='tmux list-sessions'
    alias tmn='tmux new -s'
fi

# ─── Aliases ──────────────────────────────────────────────────────────────────

# Claude
alias cc='claude'

# eza (modern ls)
if command -v eza &>/dev/null; then
    alias ls='eza'
    alias ll='eza -l --git --icons'
    alias la='eza -la --git --icons'
    alias lt='eza --tree --level=2 --icons'
else
    alias ll='ls -lh'
    alias la='ls -lAh'
fi

# bat (modern cat)
if command -v bat &>/dev/null; then
    alias cat='bat --paging=never'
fi

# fd (modern find)
if command -v fd &>/dev/null; then
    alias find='fd'
fi

# nvim (modern vim)
if command -v nvim &>/dev/null; then
    alias vi='nvim'
    alias vim='nvim'
fi

# Git shortcuts
alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph --decorate -20'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'

# ─── Local Overrides ─────────────────────────────────────────────────────────

[[ -f "${HOME}/.zshrc.local" ]] && source "${HOME}/.zshrc.local"
