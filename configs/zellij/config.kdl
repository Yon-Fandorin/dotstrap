// Zellij config — dotstrap
// Docs: https://zellij.dev/documentation/configuration

// ─── General ────────────────────────────────────────────────────────────────

default_shell "zsh"
pane_frames false
default_layout "catppuccin-mocha"
serialize_pane_viewport true
scrollback_lines_to_serialize 1000

// Copy on select
copy_on_select true

// Mouse support
mouse_mode true

// Session persistence
session_serialization true
auto_start true

// Disable startup tips
show_startup_tips false

// ─── UI ─────────────────────────────────────────────────────────────────────

simplified_ui false
styled_underlines true

ui {
    pane_frames {
        rounded_corners true
    }
}

// ─── Keybindings ────────────────────────────────────────────────────────────
// Primary modifier:   Alt        (mode switching)
// Secondary modifier: Alt+Shift  (quick actions in any mode)

keybinds {
    shared_except "locked" {
        // Remove default Ctrl/Alt bindings
        unbind "Ctrl g" "Ctrl q"
        unbind "Alt f" "Alt n" "Alt i" "Alt o"
        unbind "Alt =" "Alt +" "Alt -" "Alt [" "Alt ]" "Alt p"

        // Primary: Alt — lock / quit
        bind "Alt g" { SwitchToMode "Locked"; }
        bind "Alt q" { Quit; }

        // Secondary: Alt+Shift — quick actions
        bind "Alt Shift f" { ToggleFloatingPanes; }
        bind "Alt Shift n" { NewPane; }
        bind "Alt ," { MoveTab "Left"; }
        bind "Alt ." { MoveTab "Right"; }
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt Shift h" "Alt Shift Left" { MovePane "Left"; }
        bind "Alt Shift l" "Alt Shift Right" { MovePane "Right"; }
        bind "Alt Shift j" "Alt Shift Down" { MovePane "Down"; }
        bind "Alt Shift k" "Alt Shift Up" { MovePane "Up"; }
        bind "Alt Shift =" "Alt Shift +" { Resize "Increase"; }
        bind "Alt Shift -" { Resize "Decrease"; }
        bind "Alt Shift [" { PreviousSwapLayout; }
        bind "Alt Shift ]" { NextSwapLayout; }

        // Plugins
        bind "Alt ?" {
            LaunchOrFocusPlugin "file:~/.config/zellij/plugins/zellij_forgot.wasm" {
                floating true
                "LOAD_ZELLIJ_BINDINGS" "true"
            }
        }
    }

    // Primary: Alt — enter modes
    normal {
        unbind "Ctrl p" "Ctrl t" "Ctrl n" "Ctrl h" "Ctrl s" "Ctrl o" "Ctrl b"

        bind "Alt p" { SwitchToMode "Pane"; }
        bind "Alt t" { SwitchToMode "Tab"; }
        bind "Alt n" { SwitchToMode "Resize"; }
        bind "Alt m" { SwitchToMode "Move"; }
        bind "Alt s" { SwitchToMode "Scroll"; }
        bind "Alt o" { SwitchToMode "Session"; }
    }

    // Primary: Alt — exit modes (same key toggles back to Normal)
    locked {
        unbind "Ctrl g"
        bind "Alt g" { SwitchToMode "Normal"; }
    }
    pane {
        unbind "Ctrl p"
        bind "Alt p" { SwitchToMode "Normal"; }
    }
    tab {
        unbind "Ctrl t"
        bind "Alt t" { SwitchToMode "Normal"; }
    }
    resize {
        unbind "Ctrl n"
        bind "Alt n" { SwitchToMode "Normal"; }
    }
    move {
        unbind "Ctrl h"
        bind "Alt m" { SwitchToMode "Normal"; }
    }
    scroll {
        unbind "Ctrl s"
        bind "Alt s" { SwitchToMode "Normal"; }
    }
    search {
        unbind "Ctrl s"
        bind "Alt s" { SwitchToMode "Normal"; }
    }
    session {
        unbind "Ctrl o"
        bind "Alt o" { SwitchToMode "Normal"; }
    }
}

// ─── Theme — Catppuccin Mocha ───────────────────────────────────────────────

theme "catppuccin-mocha"

themes {
    catppuccin-mocha {
        bg "#313244"
        fg "#cdd6f4"
        red "#f38ba8"
        green "#a6e3a1"
        blue "#89b4fa"
        yellow "#f9e2af"
        magenta "#cba6f7"
        orange "#fab387"
        cyan "#89dceb"
        black "#181825"
        white "#cdd6f4"
    }
}
